# Copy this file to .env and fill in real values before running
# `docker-compose up`. .env is gitignored — never commit real secrets.
#
# Generate strong random values with:
#   openssl rand -hex 32

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=covertscope
POSTGRES_PASSWORD=changeme-generate-a-real-secret
POSTGRES_DB=covertscope

# --- Backend API ----------------------------------------------------------
# Required by every /api/* route except /api/health. Callers (including the
# dashboard) must send it as the X-API-Key header, or ?key= on the /ws
# WebSocket connection.
COVERTSCOPE_API_KEY=changeme-generate-a-real-secret

# Shared secret the nDPI C engine (ndpi-engine/covert_detector) must present
# on the flow-ingest socket (:9999) before any flow records are accepted.
# Pass the SAME value to covert_detector, e.g.:
#   sudo COVERTSCOPE_INGEST_SECRET=<this value> ./covert_detector eth0
COVERTSCOPE_INGEST_SECRET=changeme-generate-a-real-secret

# Comma-separated list of origins allowed to call the API from a browser.
# Add your dashboard's real origin here in anything beyond local dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
